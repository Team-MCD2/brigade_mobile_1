---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Boutique - La Brigade Mobile">

<!-- Top utility bar -->
<div class="topbar">
  <div class="container topbar__row">
    <span>Réparation express</span>
    <span>•</span>
    <span>Garantie 6 mois</span>
    <span>•</span>
    <span>Toulouse, Cité Madrid</span>
  </div>
</div>

<!-- Header -->
<header class="header">
  <div class="container header__row">
    <a class="logo" href="/">
      <img src="/logo-nouveau.png" alt="" />
    </a>

    <form class="search" role="search">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="text" placeholder="Rechercher" />
    </form>

    <nav class="header__nav">
      <a href="#"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M3 10h18"/></svg><span>Nos tarifs</span></a>
      <a href="#"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><span>Trouver</span></a>
      <a href="tel:0756916593"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg><span>Appeler</span></a>
    </nav>
  </div>

  <nav class="subnav">
    <div class="container subnav__row">
      <a href="/services">Réparations</a>
      <a href="/services">Services</a>
      <a href="/boutique" class="active">Boutique</a>
      <a href="/avis">Avis</a>
      <a href="/faq">FAQ</a>
      <a href="/contact">Contact</a>
      <a href="#" class="muted">Devis</a>
    </div>
  </nav>
</header>

<!-- Hero -->
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="pill">Boutique</span>
      <h1>Boutique <em>Toulouse</em></h1>
      <p>65 Route de Blagnac, 31300 Toulouse — sans rendez-vous pour le diagnostic.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="#">Devis</a>
        <a class="btn btn--ghost" href="tel:0756916593">Appeler</a>
      </div>
    </div>
    <div class="hero__art">
      <div class="blob"></div>
      <img src="/mascotte-nobg.png" alt="" class="mascotte" />
    </div>
  </div>
</section>

<!-- Informations pratiques -->
<section class="section">
  <div class="container">
    <div class="section__head">
      <h2>Informations pratiques</h2>
    </div>
    <div class="products" style="grid-template-columns: repeat(2, 1fr);">
      <article class="product" style="grid-column: span 2;">
        <div class="product__body" style="padding: 24px;">
          <h3 style="font-size:24px;margin-bottom:16px;">Adresse</h3>
          <p style="font-size:18px;color:var(--ink-2);margin-bottom:12px;">65 Route de Blagnac, 31300 Toulouse</p>
          <a href="#" class="link">Itinéraire Google Maps →</a>
        </div>
      </article>
      <article class="product">
        <div class="product__body" style="padding: 24px;">
          <h3 style="font-size:20px;margin-bottom:12px;">Horaires</h3>
          <p style="color:var(--muted);margin-bottom:8px;">Lundi - Vendredi: 9h - 19h</p>
          <p style="color:var(--muted);margin-bottom:8px;">Samedi: 10h - 18h</p>
          <p style="color:var(--muted);">Dimanche: Fermé</p>
        </div>
      </article>
      <article class="product">
        <div class="product__body" style="padding: 24px;">
          <h3 style="font-size:20px;margin-bottom:12px;">Transports</h3>
          <p style="color:var(--muted);margin-bottom:8px;">Métro L1 & Bus 70</p>
          <p style="color:var(--muted);">Arrêt « Cité Madrid », juste en face</p>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- Conseils -->
<section class="section">
  <div class="container" style="text-align:center;padding:40px 0;">
    <h2 style="font-size:28px;font-weight:800;margin-bottom:16px;">Avant de venir</h2>
    <p style="color:var(--muted);margin-bottom:24px;max-width:600px;margin-left:auto;margin-right:auto;">Vérifiez la dispo pièces ou estimez en ligne — même logique tarifaire.</p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <a class="btn btn--primary" href="#">Devis</a>
      <a class="btn btn--ghost" href="tel:0756916593">07 56 91 65 93</a>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img src="/logo-nouveau.png" alt="" />
      <p>—</p>
    </div>
    <div><h4>Services</h4><ul><li><a href="#">Devis en ligne</a></li><li><a href="/services">Services</a></li><li><a href="/services">Apple</a></li><li><a href="/services">Samsung</a></li></ul></div>
    <div><h4>Boutique</h4><ul><li><a href="/boutique">Adresse</a></li><li><a href="/boutique">Horaires</a></li><li><a href="/boutique">Accès</a></li></ul></div>
    <div><h4>Entreprise</h4><ul><li><a href="#">Devis en ligne</a></li><li><a href="/pro">Entreprises</a></li><li><a href="/a-propos">À propos</a></li></ul></div>
    <div><h4>Info</h4><ul><li><a href="/avis">Avis</a></li><li><a href="/faq">FAQ</a></li><li><a href="/contact">Contact</a></li></ul></div>
  </div>
  <div class="footer__bottom container">
    <span>© La Brigade Mobile</span>
    <span>—</span>
  </div>
</footer>

</Layout>
