---
import Layout from '../layouts/Layout.astro';
---

<Layout title="La Brigade Mobile">

<!-- Top utility bar -->
<div class="topbar">
  <div class="container topbar__row">
    <span>Réparation express</span>
    <span>•</span>
    <span>Garantie 12 mois</span>
    <span>•</span>
    <span>Toulouse, Cité Madrid</span>
  </div>
</div>

<!-- Header -->
<header class="header">
  <div class="container header__row">
    <a class="logo" href="#">
      <img src="/logo-nouveau.png" alt="" />
    </a>

    <form class="search" role="search">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="text" placeholder="Rechercher" />
    </form>

    <nav class="header__nav">
      <a href="#"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M3 10h18"/></svg><span>Nos tarifs</span></a>
      <a href="#"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><span>Trouver</span></a>
      <a href="tel:0756916593"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg><span>Appeler</span></a>
    </nav>
  </div>

  <nav class="subnav">
    <div class="container subnav__row">
      <a href="/services">Réparations</a>
      <a href="/services">Services</a>
      <a href="/boutique">Boutique</a>
      <a href="/avis">Avis</a>
      <a href="/faq">FAQ</a>
      <a href="/contact">Contact</a>
      <a href="#" class="muted">Devis</a>
    </div>
  </nav>
</header>

<!-- Hero -->
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="pill">Atelier · Toulouse</span>
      <h1>Diagnostic gratuit en boutique,<br/>devis guidé en ligne,<br/>garantie <em>6 mois</em>.</h1>
      <p>Sans promesse creuse ni jargon marketing.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="#">Devis</a>
        <a class="btn btn--ghost" href="/boutique">Adresse</a>
      </div>
    </div>
    <div class="hero__art">
      <div class="blob"></div>
      <img src="/mascotte-nobg.png" alt="" class="mascotte" />
    </div>
  </div>
</section>

<!-- Marques supportées -->
<section class="cats">
  <div class="container">
    <div class="cats__grid">
      <a class="cat"><div class="cat__ico">🍎</div><span>Apple</span></a>
      <a class="cat"><div class="cat__ico">📱</div><span>Samsung</span></a>
      <a class="cat"><div class="cat__ico">📲</div><span>Huawei</span></a>
      <a class="cat"><div class="cat__ico">📱</div><span>Xiaomi</span></a>
      <a class="cat"><div class="cat__ico">🔍</div><span>Google</span></a>
      <a class="cat"><div class="cat__ico">�</div><span>Oppo</span></a>
      <a class="cat"><div class="cat__ico">�</div><span>OnePlus</span></a>
      <a class="cat"><div class="cat__ico">�</div><span>Sony</span></a>
    </div>
    <p style="text-align:center;color:var(--muted);margin-top:16px;font-size:14px;">Consoles, PC portables, autres appareils électroniques… — même parcours sur le devis en ligne.</p>
  </div>
</section>

<!-- Ce qu'on touche, au quotidien -->
<section class="section">
  <div class="container">
    <div class="section__head">
      <h2>Ce qu'on touche, au quotidien</h2>
      <p style="color:var(--muted)">Pas d'icônes « appli » — des liens vers des fiches utiles, point.</p>
    </div>
    <div class="products">
      <article class="product"><div class="product__img"></div><div class="product__body"><span class="tag">Smartphones & tablettes</span><h3>Écran, batterie, caméra, connecteur, désoxydation</h3><p style="font-size:13px;color:var(--muted);margin-top:4px;">Atelier, pièces contrôlées</p></div></article>
      <article class="product"><div class="product__img"></div><div class="product__body"><span class="tag">Connecteur & charge</span><h3>Port usé, charge intermittente</h3></div></article>
      <article class="product"><div class="product__img"></div><div class="product__body"><span class="tag">Désoxydation</span><h3>Contact avec l'eau</h3><p style="font-size:13px;color:var(--muted);margin-top:4px;">Agir vite</p></div></article>
      <article class="product"><div class="product__img"></div><div class="product__body"><span class="tag">Diagnostic gratuit</span><h3>Sans engagement</h3><p style="font-size:13px;color:var(--muted);margin-top:4px;">Devis clair sur place ou en ligne</p></div></article>
    </div>
    <div style="text-align:center;margin-top:24px;">
      <a href="/services" class="link">Tout l'index →</a>
    </div>
  </div>
</section>

<!-- Trois temps. Zéro flou -->
<section class="promo">
  <div class="container promo__row">
    <div class="promo__txt">
      <span class="pill pill--yellow">Processus</span>
      <h2>Trois temps.<br/>Zéro flou.</h2>
      <div style="margin:20px 0;">
        <p style="margin-bottom:12px;"><strong>1.</strong> Vous décrivez : Devis en ligne ou passage boutique — même transparence.</p>
        <p style="margin-bottom:12px;"><strong>2.</strong> On diagnostique : Gratuit, sous vos yeux — prix ferme avant intervention.</p>
        <p><strong>3.</strong> On répare : Souvent ~30 min · garantie 6 mois.</p>
      </div>
      <a class="btn btn--dark" href="#">Devis en ligne</a>
    </div>
    <div class="promo__art"><img src="/mascotte-nobg.png" alt="" class="mascotte" /></div>
  </div>
</section>

<!-- Valeurs -->
<section class="trust">
  <div class="container trust__row">
    <div class="trust__item"><div class="trust__ico">⚡</div><span>Rapide : ~30 min</span></div>
    <div class="trust__item"><div class="trust__ico">🔍</div><span>Transparent : Prix en ligne</span></div>
    <div class="trust__item"><div class="trust__ico">✅</div><span>Garanti : 6 mois</span></div>
    <div class="trust__item"><div class="trust__ico">🔧</div><span>Polyvalent : MacBook, PC</span></div>
  </div>
</section>

<!-- Avis Clients + Footer CTA -->
<section class="section">
  <div class="container edit__grid">
    <a class="edit edit--lg" href="/avis">
      <div class="edit__txt"><h3>Avis Clients</h3><span>Charles H. (Google) — Lire les avis</span></div>
    </a>
    <a class="edit edit--lg edit--alt">
      <div class="edit__txt"><h3>Deux minutes en ligne</h3><span>— ou passez sans rendez-vous pour le diagnostic</span></div>
    </a>
  </div>
  <div style="text-align:center;margin-top:32px;">
    <a class="btn btn--primary" href="#">Devis</a>
    <p style="margin-top:12px;color:var(--muted);">07 56 91 65 93</p>
  </div>
</section>

<!-- Footer -->
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img src="/logo-nouveau.png" alt="" />
      <p>—</p>
    </div>
    <div><h4>Services</h4><ul><li><a href="#">Devis en ligne</a></li><li><a href="/services">Services</a></li><li><a href="/services">Apple</a></li><li><a href="/services">Samsung</a></li></ul></div>
    <div><h4>Boutique</h4><ul><li><a href="/boutique">Adresse</a></li><li><a href="/boutique">Horaires</a></li><li><a href="/boutique">Accès</a></li></ul></div>
    <div><h4>Entreprise</h4><ul><li><a href="#">Devis en ligne</a></li><li><a href="/pro">Entreprises</a></li><li><a href="/a-propos">À propos</a></li></ul></div>
    <div><h4>Info</h4><ul><li><a href="/avis">Avis</a></li><li><a href="/faq">FAQ</a></li><li><a href="/contact">Contact</a></li></ul></div>
  </div>
  <div class="footer__bottom container">
    <span>© La Brigade Mobile</span>
    <span>—</span>
  </div>
</footer>

</Layout>
