---
import Layout from '../layouts/Layout.astro';
---

<Layout title="La Brigade Mobile">

<!-- Top utility bar -->
<div class="topbar">
  <div class="container topbar__row">
    <span>Livraison gratuite</span>
    <span>•</span>
    <span>Garantie 12 mois</span>
    <span>•</span>
    <span>Reconditionné en France</span>
  </div>
</div>

<!-- Header -->
<header class="header">
  <div class="container header__row">
    <a class="logo" href="#">
      <img src="/logo-nouveau.png" alt="" />
    </a>

    <form class="search" role="search">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="text" placeholder="Rechercher" />
    </form>

    <nav class="header__nav">
      <a href="#"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><span>Compte</span></a>
      <a href="#"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg><span>Favoris</span></a>
      <a href="#"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg><span>Panier</span></a>
    </nav>
  </div>

  <nav class="subnav">
    <div class="container subnav__row">
      <a href="#">Smartphones</a>
      <a href="#">Ordinateurs</a>
      <a href="#">Tablettes</a>
      <a href="#">Audio</a>
      <a href="#">Consoles</a>
      <a href="#">Photo</a>
      <a href="#">Accessoires</a>
      <a href="#" class="muted">Réparation</a>
      <a href="#" class="muted">Reprise</a>
    </div>
  </nav>
</header>

<!-- Hero -->
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="pill">Reconditionné · Garanti</span>
      <h1>Du mobile <em>réparé</em>.<br/>Au prix juste.</h1>
      <p>—</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="#">Acheter</a>
        <a class="btn btn--ghost" href="#">Faire réparer</a>
      </div>
    </div>
    <div class="hero__art">
      <div class="blob"></div>
      <img src="/mascotte.png" alt="" />
    </div>
  </div>
</section>

<!-- Category chips -->
<section class="cats">
  <div class="container">
    <div class="cats__grid">
      <a class="cat"><div class="cat__ico">📱</div><span>iPhone</span></a>
      <a class="cat"><div class="cat__ico">📲</div><span>Samsung</span></a>
      <a class="cat"><div class="cat__ico">💻</div><span>MacBook</span></a>
      <a class="cat"><div class="cat__ico">🖥️</div><span>PC</span></a>
      <a class="cat"><div class="cat__ico">📟</div><span>iPad</span></a>
      <a class="cat"><div class="cat__ico">🎧</div><span>AirPods</span></a>
      <a class="cat"><div class="cat__ico">⌚</div><span>Watch</span></a>
      <a class="cat"><div class="cat__ico">🎮</div><span>Console</span></a>
    </div>
  </div>
</section>

<!-- Product grid -->
<section class="section">
  <div class="container">
    <div class="section__head">
      <h2>Sélection</h2>
      <a href="#" class="link">Tout voir →</a>
    </div>
    <div class="products">
      <article class="product"><div class="product__img"></div><div class="product__body"><span class="tag">Très bon état</span><h3>—</h3><div class="price"><strong>—</strong><s>—</s></div></div></article>
      <article class="product"><div class="product__img"></div><div class="product__body"><span class="tag">Comme neuf</span><h3>—</h3><div class="price"><strong>—</strong><s>—</s></div></div></article>
      <article class="product"><div class="product__img"></div><div class="product__body"><span class="tag">Bon état</span><h3>—</h3><div class="price"><strong>—</strong><s>—</s></div></div></article>
      <article class="product"><div class="product__img"></div><div class="product__body"><span class="tag">Très bon état</span><h3>—</h3><div class="price"><strong>—</strong><s>—</s></div></div></article>
      <article class="product"><div class="product__img"></div><div class="product__body"><span class="tag">Comme neuf</span><h3>—</h3><div class="price"><strong>—</strong><s>—</s></div></div></article>
      <article class="product"><div class="product__img"></div><div class="product__body"><span class="tag">Bon état</span><h3>—</h3><div class="price"><strong>—</strong><s>—</s></div></div></article>
      <article class="product"><div class="product__img"></div><div class="product__body"><span class="tag">Très bon état</span><h3>—</h3><div class="price"><strong>—</strong><s>—</s></div></div></article>
      <article class="product"><div class="product__img"></div><div class="product__body"><span class="tag">Comme neuf</span><h3>—</h3><div class="price"><strong>—</strong><s>—</s></div></div></article>
    </div>
  </div>
</section>

<!-- Promo banner -->
<section class="promo">
  <div class="container promo__row">
    <div class="promo__txt">
      <span class="pill pill--yellow">Réparation</span>
      <h2>Écran cassé ?<br/>On s'en occupe.</h2>
      <a class="btn btn--dark" href="#">Prendre RDV</a>
    </div>
    <div class="promo__art"><img src="/mascotte.png" alt="" /></div>
  </div>
</section>

<!-- Trust strip -->
<section class="trust">
  <div class="container trust__row">
    <div class="trust__item"><div class="trust__ico">✅</div><span>Garantie 12 mois</span></div>
    <div class="trust__item"><div class="trust__ico">🚚</div><span>Livraison offerte</span></div>
    <div class="trust__item"><div class="trust__ico">↩️</div><span>30 jours pour changer d'avis</span></div>
    <div class="trust__item"><div class="trust__ico">🔧</div><span>Réparation express</span></div>
  </div>
</section>

<!-- Editorial blocks -->
<section class="section">
  <div class="container edit__grid">
    <a class="edit edit--lg">
      <div class="edit__txt"><h3>iPhone</h3><span>—</span></div>
    </a>
    <a class="edit">
      <div class="edit__txt"><h3>MacBook</h3><span>—</span></div>
    </a>
    <a class="edit">
      <div class="edit__txt"><h3>Samsung</h3><span>—</span></div>
    </a>
    <a class="edit edit--lg edit--alt">
      <div class="edit__txt"><h3>Reprise</h3><span>—</span></div>
    </a>
  </div>
</section>

<!-- Footer -->
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img src="/logo-nouveau.png" alt="" />
      <p>—</p>
    </div>
    <div><h4>Acheter</h4><ul><li>—</li><li>—</li><li>—</li><li>—</li></ul></div>
    <div><h4>Vendre</h4><ul><li>—</li><li>—</li><li>—</li></ul></div>
    <div><h4>Aide</h4><ul><li>—</li><li>—</li><li>—</li></ul></div>
    <div><h4>Société</h4><ul><li>—</li><li>—</li><li>—</li></ul></div>
  </div>
  <div class="footer__bottom container">
    <span>© La Brigade Mobile</span>
    <span>—</span>
  </div>
</footer>

</Layout>
